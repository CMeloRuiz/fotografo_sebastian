# Configuracion de Apache para el hosting de Hostinger.
#
# Este archivo vive en frontend/public/, asi que Vite lo copia tal cual a
# dist/ en cada build y acaba en public_html junto al resto del sitio.

# ── Redirecciones del sitio antiguo ──────────────────────────
# Van primero: si no, la regla del SPA se las tragaria antes de llegar aqui.
# 301 es permanente, que es lo que le dice a Google que mueva el
# posicionamiento a la URL nueva en vez de tratarla como otra pagina.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  RewriteRule ^index\.html$ / [R=301,L]
  RewriteRule ^portafolio\.html$ /portafolio [R=301,L]
  RewriteRule ^contacto\.html$ /contacto [R=301,L]

  # Los cinco albumes antiguos van al portafolio: sus fotos eran privadas
  # de cada cliente y no se migraron, asi que no hay pagina equivalente.
  RewriteRule ^(daniela|dayana|jimena_alejandro|juanjose|michelle)\.html$ /portafolio [R=301,L]

  # ── Rutas del SPA ──────────────────────────────────────────
  # Cualquier ruta que no sea un archivo real la resuelve React.
  # Sin esto, recargar /portafolio devuelve un 404 de Apache.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# ── Cache ────────────────────────────────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On

  # Los archivos de /assets/ llevan un hash en el nombre: si cambia el
  # contenido, cambia el nombre. Se pueden cachear para siempre.
  <FilesMatch "\.(js|css)$">
    ExpiresDefault "access plus 1 year"
    Header set Cache-Control "public, immutable"
  </FilesMatch>

  <FilesMatch "\.(avif|webp|jpg|jpeg|png|svg|woff2)$">
    ExpiresDefault "access plus 30 days"
  </FilesMatch>

  # index.html no se cachea: es el que apunta a los demas y tiene que
  # reflejar el despliegue nuevo de inmediato.
  <FilesMatch "^index\.html$">
    ExpiresDefault "access plus 0 seconds"
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# ── Compresion ───────────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ── Seguridad ────────────────────────────────────────────────
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# Que no se listen los directorios sin index
Options -Indexes
