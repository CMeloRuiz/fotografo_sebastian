# ─────────────────────────────────────────────────────────────
#  Backend de Sebastián Sisa
#  Copia este archivo a .env y complétalo. .env NUNCA se sube al repo.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=4000

# ── Supabase ─────────────────────────────────────────────────
# La URL esta en Settings > Data API > Project URL.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
#
# La clave del servidor, en Settings > API Keys. Acepta las dos formas:
#   - la nueva "secret key"  (sb_secret_...)   <- preferida
#   - la antigua "service_role" (eyJ...), en la pestana de legacy
# Supabase retira las legacy a finales de 2026, asi que en proyectos
# nuevos usa la secret key.
#
# Cualquiera de las dos ignora RLS y puede leer y escribir todo: va solo
# en el servidor, nunca en el navegador ni en una variable VITE_*.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=photos

# ── Sesión del admin ─────────────────────────────────────────
# Genera uno con:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_TTL=7d

# 'lax' si la API va en un subdominio del mismo dominio que el sitio
# (api.tudominio.com). Solo hace falta 'none' si vive en otro dominio,
# y entonces Safari bloquea la sesion por ser cookie de terceros.
COOKIE_SAMESITE=lax

# ── CORS ─────────────────────────────────────────────────────
# Orígenes del frontend, separados por comas.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# ── Correo de aviso del formulario ───────────────────────────
# Opcional: sin esto el mensaje igual se guarda y se ve en el panel.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Sitio web <no-reply@sebastiansisa.com>
MAIL_TO=

# ── Subidas ──────────────────────────────────────────────────
MAX_UPLOAD_MB=25
MAX_UPLOAD_FILES=20

# ── Sitio ────────────────────────────────────────────────────
SITE_URL=http://localhost:5173

# ── Usuario administrador inicial (solo para npm run seed) ───
ADMIN_EMAIL=sebastian@sebastiansisa.com
ADMIN_PASSWORD=
