# ─────────────────────────────────────────────────────────────
#  Backend de Sebastián Sisa
#  Copia este archivo a .env y complétalo. .env NUNCA se sube al repo.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=4000

# ── Supabase ─────────────────────────────────────────────────
# Panel de Supabase > Project Settings > API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# service_role, NO la anon key. Ignora RLS: solo en el servidor.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=photos

# ── Sesión del admin ─────────────────────────────────────────
# Genera uno con:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_TTL=7d

# ── CORS ─────────────────────────────────────────────────────
# Orígenes del frontend, separados por comas.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# ── Correo de aviso del formulario ───────────────────────────
# Opcional: sin esto el mensaje igual se guarda y se ve en el panel.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Sitio web <no-reply@sebastiansisa.com>
MAIL_TO=

# ── Subidas ──────────────────────────────────────────────────
MAX_UPLOAD_MB=25
MAX_UPLOAD_FILES=20

# ── Sitio ────────────────────────────────────────────────────
SITE_URL=http://localhost:5173

# ── Usuario administrador inicial (solo para npm run seed) ───
ADMIN_EMAIL=sebastian@sebastiansisa.com
ADMIN_PASSWORD=
